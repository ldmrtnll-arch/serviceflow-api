DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://serviceflow:serviceflow@db:5432/serviceflow
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
# Celery Beat checks SLA deadlines every 60 seconds (configured in Django settings).
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=serviceflow-attachments
S3_REGION_NAME=us-east-1
S3_PRESIGNED_URL_EXPIRATION=300
MAX_ATTACHMENT_SIZE_BYTES=10485760

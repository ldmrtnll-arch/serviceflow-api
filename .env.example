DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=postgresql://serviceflow:serviceflow@db:5432/serviceflow
DB_CONN_MAX_AGE=60
DB_STATEMENT_TIMEOUT_MS=30000
CACHE_URL=redis://redis:6379/1
LOG_LEVEL=INFO
SLOW_REQUEST_THRESHOLD_MS=500
THROTTLE_ANON_RATE=100/hour
THROTTLE_USER_RATE=1000/hour
THROTTLE_LOGIN_RATE=10/minute
THROTTLE_REGISTER_RATE=5/minute
THROTTLE_UPLOAD_RATE=30/hour
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-Proto.
SECURE_PROXY_SSL_HEADER_ENABLED=false
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
# Celery Beat checks SLA deadlines every 60 seconds (configured in Django settings).
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=serviceflow-attachments
S3_REGION_NAME=us-east-1
S3_PRESIGNED_URL_EXPIRATION=300
MAX_ATTACHMENT_SIZE_BYTES=10485760
S3_CONNECT_TIMEOUT_SECONDS=3
S3_READ_TIMEOUT_SECONDS=10
S3_MAX_ATTEMPTS=3
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30
LOADTEST_EMAIL=requester@serviceflow.local
LOADTEST_PASSWORD=ServiceFlow123!
